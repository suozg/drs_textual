/* styles.tcss */

/* =========================================================
   ГЛОБАЛЬНІ СТИЛІ ТА ВІДЖЕТИ ВВОДУ
   ========================================================= */

/* Головне вікно додатка (темна тема Gruvbox) */
Screen {
    background: #282828;            /* Темно-сірий фоновий колір */
    color: #ebdbb2;                 /* Світло-бежевий колір тексту */
}

/* Базові поля введення тексту (Input) */
Input {
    background: #3c3836;            /* Фон поля введення */
    color: #ebdbb2;                 /* Колір тексту */
    border: solid #665c54;          /* Рамка поля у звичайному стані */
}

/* Поле введення при отриманні фокусу (активне) */
Input:focus {
    border: solid #d79921;          /* Жовта/золотиста рамка при фокусі */
}

/* Текст всередині Input на позиції курсора */
Input > .input--cursor {
    color: #ebdbb2;                 /* Колір символу під курсором */
}


/* =========================================================
   ВКЛАДКА ПОШУКУ (SEARCH TAB)
   ========================================================= */

/* Верхня панель параметрів пошуку */
#search_bar {
    height: 5;
    width: 100%;
    padding: 1 1;
    align: left middle;              /* Вирівнювання елементів по лівому краю та центру висоти */
}

/* Поле для введення пошукового запиту */
#search_input {
    width: 1fr;                     /* Займає весь вільний простір по ширині */
    min-width: 15;
    height: 3;
}

/* Текстові підписи "Від:" та "До:" біля полів дат */
#date_label_start,
#date_label_end {
    width: 4;
    height: 3;
    content-align: center middle;   /* Центрування тексту всередині блоку */
}

/* Поля введення дат "Від" і "До" */
.date_in {
    width: 13;
    min-width: 13;
    height: 3;
    margin-left: 1;
}

/* Блок відображення кількості знайдених записів */
#lbl_count {
    height: 2;
    width: 100%;
    padding: 0 1;
}

/* Кнопка запуску/зупинки пошуку */
#btn_search {
    width: 12;
    min-width: 12;
    height: 3;
    margin-left: 1;
}

/* Кнопка відображення всіх документів "∞" */
#btn_all {
    width: 5;
    min-width: 5;
    height: 3;
    margin-left: 1;
}

/* Кнопка видалення вибраного документа */
#btn_delete {
    width: 6;
    height: 3;
    margin-left: 1;
}


/* ---------------------------------------------------------
   Результати пошуку + Панель перегляду документа
   --------------------------------------------------------- */

/* Список знайдених документів (ліва колонка) */
#results_list {
    width: 32;
    min-width: 25;
    height: 1fr;                     /* Розтягується по вертикалі на весь доступний простір */
    margin: 0 1 1 1;
}

/* Головний контейнер результатів (список + область документа) */
#search_content {
    width: 100%;
    height: 1fr;
}

/* Права панель для перегляду та пошуку у документі */
#document_panel {
    width: 1fr;
    height: 1fr;
    margin: 0 1 1 0;
}

/* Заголовок документа з назвою та датою */
#doc_header {
    width: 100%;
    height: 2;
    padding: 0 1;
}

/* Текстове поле з вмістом документа (TextArea) */
#doc_content {
    width: 100%;
    height: 1fr;
    min-height: 5;
}

/* Стиль рядка з курсором у TextArea (неактивний фокус) */
#doc_content .text-area--cursor-line {
    background: $accent 30%;        /* 30% прозорості акцентного кольору для фону рядка */
    color: $text;                   /* Колір тексту на поточному рядку */
}

/* Стиль рядка з курсором у TextArea (коли активний фокус на документі) */
#doc_content:focus .text-area--cursor-line {
    background: $accent 50%;        /* Більш контрастний 50% фон при фокусі */
    text-style: bold;               /* Жирне накреслення тексту на рядку курсора */
}


/* ---------------------------------------------------------
   Пошук всередині вмісту документа
   --------------------------------------------------------- */

/* Нижня панель навігації по тексту документа */
#search_inside {
    width: 100%;
    height: 3;
    margin-top: 0;
}

/* Поле введення слова для пошуку у тексті */
#in_text_input {
    width: 1fr;
    height: 3;
}

/* Спільні стилі для кнопок пошуку та навігації у тексті */
#btn_find_in_text,
#btn_prev_match,
#btn_next_match {
    height: 3;
    margin-left: 1;
}

/* Кнопка "Шукати" у тексті */
#btn_find_in_text {
    width: 10;
}

/* Кнопки переходу між збігами "⬅ Назад" та "Вперед ➡" */
#btn_prev_match,
#btn_next_match {
    width: 10;
}


/* ---------------------------------------------------------
   Вікно підтвердження видалення файлу (ModalScreen)
   --------------------------------------------------------- */

/* Затемнений задній фон під час виклику модального вікна */
ConfirmDeleteScreen {
    align: center middle;            /* Центрування діалогового вікна на екрані */
    background: rgba(0, 0, 0, 0.6);  /* Напівпрозорий чорний фон overlay */
}

/* Основний контейнер модального діалогу */
#confirm_dialog {
    width: 55;
    height: auto;
    background: $surface;            /* Фоновий колір поверхні системи */
    border: thick $primary;          /* Товста рамка акцентного кольору */
    padding: 1 2;
}

/* Текст питання у вікні підтвердження */
#confirm_msg {
    content-align: center middle;   /* Центрування тексту повідомлення */
    margin-bottom: 1;
}

/* Панель з кнопками дій у модальному вікні */
#confirm_buttons {
    align: center middle;            /* Центрування кнопок по горизонталі */
    height: 3;
}

/* Відступи між кнопками у вікні підтвердження */
#confirm_buttons Button {
    margin: 0 1;
}


/* =========================================================
   ВКЛАДКА ІМПОРТУ (TAB IMPORT)
   ========================================================= */

/* Головний контейнер вкладки імпорту */
#import_main {
    width: 100%;
    height: 1fr;
}

/* Рядок вибору бази даних для імпорту */
#import_db_row {
    width: 100%;
    height: 3;
    margin: 0;
    align: left middle;
}

/* Текстова мітка перед випадаючим списком БД */
#import_db_row .label {
    width: 25;
    height: 3;
    padding: 1 1 0 0;
}

/* Блок із назвою вибраної БД */
#import_db_selected {
    width: 1fr;
    height: 3;
    padding: 1 1;
    content-align: left middle;
}

/* Випадаючий список вибору БД (Select) */
#import_db_select {
    width: 30;
    min-width: 20;
    height: 3;
    background: #3c3836;
    color: #ebdbb2;
    border: solid #665c54;
    content-align: left middle;
}

/* Випадаючий список у стані фокусу */
#import_db_select:focus {
    border: solid #d79921;
}

/* Поле введення шляху до папки імпорту */
#import_folder_input {
    width: 100%;
    height: 3;
    margin: 1 0;
}

/* Панель керування процесом імпорту */
#import_buttons {
    width: 100%;
    height: 3;
    margin: 0;
}

/* Індикатор поточного статусу імпорту */
#import_status_label {
    width: 100%;
    height: 2;
    margin: 0;
}

/* Журнал (лог) виконання процедури імпорту */
#import_log {
    width: 100%;
    height: 1fr;
    min-height: 5;
    margin: 0;
}


/* =========================================================
   ВКЛАДКА SQL (TAB SQL)
   ========================================================= */

/* Головний контейнер вкладки виконання SQL-запитів */
#sql_main {
    width: 100%;
    height: 1fr;
}

/* Рядок вибору цільової БД для SQL-запиту */
#sql_db_row {
    width: 100%;
    height: 3;
    margin: 0;
    align: left middle;
}

/* Підпис до поля вибору БД в SQL */
#sql_db_row .label {
    width: 25;
    height: 3;
    padding: 1 1 0 0;
}

/* Випадаючий список БД для SQL-запитів */
#sql_db_select {
    width: 30;
    min-width: 20;
    height: 3;
    background: #3c3836;
    color: #ebdbb2;
    border: solid #665c54;
    content-align: left middle;
}

/* Активний стан списку БД */
#sql_db_select:focus {
    border: solid #d79921;
}

/* Текст з інформацією про вибрану БД */
#sql_db_selected {
    width: 1fr;
    height: 3;
    padding: 1 1;
    content-align: left middle;
}

/* Заголовок перед полем введення SQL */
#sql_label {
    width: 100%;
    height: 2;
    margin: 1 0 0 0;
}

/* Поле для написання SQL-запиту */
#sql_input {
    width: 100%;
    height: 4;
    min-height: 3;
}

/* Панель із кнопкою виконання запиту */
#sql_buttons {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
}

/* Таблиця/сітка відображення результатів SQL-запиту */
#sql_grid {
    width: 100%;
    height: 1fr;
    margin: 1 0 0 0;
}


/* =========================================================
   ЗАГАЛЬНІ ЕЛЕМЕНТИ ІНТЕРФЕЙСУ (COMMON UI)
   ========================================================= */

/* Стандартні кнопки */
Button {
    background: #504945;            /* Фон звичайної кнопки */
    color: #ebdbb2;                 /* Колір тексту */
    border: solid #665c54;          /* Рамка */
}

/* Кнопки при наведенні миші або отриманні фокусу */
Button:hover,
Button:focus {
    background: #665c54;            /* Світліший фон */
    color: #fbf1c7;                 /* Яскравіший текст */
}

/* Головні/акцентні кнопки (-primary) */
Button.-primary {
    background: #458588;            /* Синьо-зелений фон */
    color: #fbf1c7;
}

/* Головні кнопки при наведенні */
Button.-primary:hover {
    background: #689d6a;            /* Зелений фон */
    color: #ffffff;
}

/* Базовий стиль для всіх текстових міток (Static) */
Static {
    color: #ebdbb2;
}

/* Стандартні модальні екрани додатка */
ModalScreen {
    background: #282828 90%;        /* 90% непрозорості темного фону */
}

/* Загальні діалогові блоки всередині модальних вікон */
#dialog {
    background: #3c3836;
    border: solid #665c54;
    padding: 1 2;
}

/* Акцентні заголовки (.title) */
.title {
    color: #fabd2f;                 /* Яскраво-жовтий колір Gruvbox */
    text-style: bold;
}

/* Базові контейнери інтерфейсу */
.container {
    background: #282828;
}

/* Сітки вибору (Grid) */
Grid {
    background: #3c3836;
}

/* Нижня панель статусів підказок (Footer) */
Footer {
    background: #1d2021;            /* Майже чорний фон */
    color: #ebdbb2;
}


/* =========================================================
   ВКЛАДКА "ПРО ПРОГРАМУ" ТА ГРА СОКОБАН (TAB ABOUT)
   ========================================================= */

/* Головний горизонтальний розклад всієї вкладки "Про програму" */
AboutTab Horizontal {
    width: 100%;
    height: 100%;
}

/* Ліва панель — текстова довідка (RichLog) */
#about_help_text {
    width: 1fr;                     /* Рівномірно ділить простір із грою */
    height: 100%;
    background: #1e1e1e;            /* Темний фоновий колір для довідки */
    border: solid #333333;          /* Строга темна рамка */
    margin-right: 1;                /* Відступ справа від блоку гри */
    padding: 1;
}

/* Права панель — контейнер гри Сокобан */
#sokoban_container {
    width: 1fr;                     /* Рівномірно ділить простір із довідкою */
    height: 100%;
    background: #252526;            /* Тільки світліший тон фону для контрасту з лівою частиною */
    border: solid #007acc;          /* Акцентна синя рамка навколо ігрової зони */
    padding: 1;
    align: center middle;           /* Центрування ігрових елементів */
}

/* Заголовок над ігровим полем з інструкцією щодо керування */
#sokoban_label {
    width: 100%;
    text-align: center;
    text-style: bold;
    margin-bottom: 1;               /* Відступ до ігрового поля */
}

/* Сама ігрова область (Custom Widget Sokoban) */
#sokoban_game {
    width: 1fr;
    height: 1fr;                    /* Займає максимальний доступний простір */
    content-align: center middle;   /* Центрування карти рівня всередині віджета */
    background: #1d1d1d;            /* Глибокий темний фон поля */
    border: inner #444444;          /* Внутрішня рамка для ефекту заглиблення */
    margin-bottom: 1;               /* Відступ між грою та кнопками перемикання рівнів */
}

/* Панель з кнопками перемикання рівнів (◄, 1/4, ►) */
#level_controls {
    height: 3;
    width: 100%;
    align: center middle;           /* Центрування елементів керування рівнем */
}

/* Текстовий індикатор поточного рівня */
#lbl_level {
    width: 10;
    content-align: center middle;
    text-style: bold;
}

/* Кнопки перемикання рівнів (◄ та ►) */
#btn_prev_level, 
#btn_next_level {
    width: 6;
    min-width: 6;
}
